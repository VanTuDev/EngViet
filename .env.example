# Copy to `.env.local` for local dev. `.env*.local` is gitignored.
# Trên Render các biến này set ở Dashboard / render.yaml (xem Backend-EngViet/DEPLOY.md).
# LƯU Ý: NEXT_PUBLIC_* được nhúng vào bundle lúc build — đổi xong phải build lại.

# URL gốc của NestJS API, gồm prefix /api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# URL công khai của chính web này (dùng cho canonical / OG / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL server-side tới API (mặc định = NEXT_PUBLIC_API_URL). Tách ra khi FE server
# và API chạy trong cùng mạng nội bộ với hostname khác public.
API_URL=http://localhost:4000/api/v1
